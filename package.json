{
  "name": "usj-wait-nav",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "build:en-release": "npm run check:content && node scripts/build-en-release.mjs",
    "check:content": "node scripts/check-content-parity.mjs",
    "deploy:en-release": "npm run build:en-release && wrangler deploy --config dist/en-release/wrangler.jsonc",
    "dev": "wrangler dev --local",
    "check": "node --check src/index.js",
    "test:crm": "node --test tests/line-plan.test.mjs",
    "test:survey": "node --test tests/line-survey.test.mjs",
    "build:crm": "node admin-crm/scripts/sync-ride-names.mjs && node --test admin-crm/tests/admin.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.147.0"
  }
}
