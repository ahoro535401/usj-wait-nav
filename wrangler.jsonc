{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "usj-wait-nav",
  "main": "src/index.js",
  "compatibility_date": "2026-10-04",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "none",
    "run_worker_first": ["/", "/en", "/en/", "/plan", "/map", "/map-locations.json", "/privacy", "/sitemap.xml", "/api/*", "/x-card/*"]
  },
  "triggers": {
    "crons": ["*/5 * * * *", "2,22,42 * * * *"]
  },
  "vars": {
    "BUFFER_X_CHANNEL_ID": "6ac8e0a16a5c39ccb660d868",
    "X_AUTOPOST_ENABLED": "true"
  },
  "images": {
    "binding": "IMAGES"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "usj-wait-nav-db",
      "database_id": "56859b57-f992-4bfc-883f-214e3a9dd9b3"
    }
  ],
  "observability": {
    "enabled": true
  }
}
